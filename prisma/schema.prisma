datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  BENDAHARA
  ADMIN_BARCODE
  PESERTA
}

enum ParticipantType {
  INDIVIDUAL
  TEAM
}

enum Gender {
  L
  P
}

enum RegistrationStatus {
  WAITING_VERIFICATION
  PAYMENT_REJECTED
  APPROVED
  CANCELLED
}

enum PaymentStatus {
  WAITING_VERIFICATION
  APPROVED
  REJECTED
}

enum VerificationAction {
  APPROVED
  REJECTED
}

enum CheckInMethod {
  QR_SCAN
  MANUAL_CODE
}

model User {
  id             String    @id @default(uuid()) @db.VarChar(36)
  name           String    @db.VarChar(150)
  email          String    @unique @db.VarChar(150)
  phoneNumber    String    @map("phone_number") @db.VarChar(30)
  passwordHash   String    @map("password_hash") @db.VarChar(255)
  role           Role      @default(PESERTA)
  isActive       Boolean   @default(true) @map("is_active")
  sessionVersion Int       @default(1) @map("session_version")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  registrations          Registration[]
  verificationsPerformed PaymentVerificationLog[]
  checkInsPerformed      CheckIn[]  @relation("CheckInStaff1")
  checkIns2Performed     CheckIn[]  @relation("CheckInStaff2")
  auditLogs              AuditLog[]

  @@map("users")
}

model CompetitionCategory {
  id          String   @id @default(uuid()) @db.VarChar(36)
  name        String   @unique @db.VarChar(100)
  slug        String   @unique @db.VarChar(100)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  levels CompetitionLevel[]

  @@map("competition_categories")
}

model CompetitionLevel {
  id         String   @id @default(uuid()) @db.VarChar(36)
  categoryId String   @map("category_id") @db.VarChar(36)
  name       String   @db.VarChar(100)
  slug       String   @db.VarChar(100)
  createdAt  DateTime @default(now()) @map("created_at")

  category CompetitionCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  branches CompetitionBranch[]

  @@unique([categoryId, name])
  @@map("competition_levels")
}

model CompetitionBranch {
  id               String          @id @default(uuid()) @db.VarChar(36)
  levelId          String          @map("level_id") @db.VarChar(36)
  name             String          @db.VarChar(150)
  participantType  ParticipantType @map("participant_type")
  registrationFee  Decimal         @default(150000.00) @map("registration_fee") @db.Decimal(12, 2)
  minTeamMembers   Int?            @map("min_team_members")
  maxTeamMembers   Int?            @map("max_team_members")
  description      String?         @db.Text
  juknisUrl        String?         @map("juknis_url") @db.VarChar(500)
  maxRegistrants   Int?            @map("max_registrants")
  isActive         Boolean         @default(true) @map("is_active")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  level         CompetitionLevel @relation(fields: [levelId], references: [id], onDelete: Cascade)
  registrations Registration[]

  @@unique([levelId, name])
  @@map("competition_branches")
}

model PaymentAccount {
  id            String   @id @default(uuid()) @db.VarChar(36)
  bankName      String   @map("bank_name") @db.VarChar(100)
  accountNumber String   @map("account_number") @db.VarChar(50)
  accountHolder String   @map("account_holder") @db.VarChar(150)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  payments Payment[]

  @@map("payment_accounts")
}

model Registration {
  id                 String             @id @default(uuid()) @db.VarChar(36)
  registrationNumber String             @unique @map("registration_number") @db.VarChar(50)
  userId             String             @map("user_id") @db.VarChar(36)
  branchId           String             @map("branch_id") @db.VarChar(36)
  status             RegistrationStatus @default(WAITING_VERIFICATION)
  qrCodeToken        String             @unique @map("qr_code_token") @db.VarChar(255)
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  branch                CompetitionBranch      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  individualParticipant IndividualParticipant?
  team                  Team?
  payments              Payment[]
  checkIn               CheckIn?

  @@index([userId])
  @@index([branchId])
  @@index([status])
  @@index([qrCodeToken])
  @@map("registrations")
}

model IndividualParticipant {
  id             String   @id @default(uuid()) @db.VarChar(36)
  registrationId String   @unique @map("registration_id") @db.VarChar(36)
  fullName       String   @map("full_name") @db.VarChar(150)
  gender         Gender
  gradeClass     String   @map("grade_class") @db.VarChar(50)
  schoolName     String   @map("school_name") @db.VarChar(200)
  schoolAddress  String   @map("school_address") @db.Text
  mentorName     String   @map("mentor_name") @db.VarChar(150)
  whatsappNumber String   @map("whatsapp_number") @db.VarChar(30)
  createdAt      DateTime @default(now()) @map("created_at")

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@map("individual_participants")
}

model Team {
  id             String   @id @default(uuid()) @db.VarChar(36)
  registrationId String   @unique @map("registration_id") @db.VarChar(36)
  teamName       String   @map("team_name") @db.VarChar(150)
  schoolName     String   @map("school_name") @db.VarChar(200)
  schoolAddress  String   @map("school_address") @db.Text
  mentorName     String   @map("mentor_name") @db.VarChar(150)
  whatsappNumber String   @map("whatsapp_number") @db.VarChar(30)
  leaderName     String   @map("leader_name") @db.VarChar(150)
  createdAt      DateTime @default(now()) @map("created_at")

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  members      TeamMember[]

  @@map("teams")
}

model TeamMember {
  id           String   @id @default(uuid()) @db.VarChar(36)
  teamId       String   @map("team_id") @db.VarChar(36)
  memberName   String   @map("member_name") @db.VarChar(150)
  gender       Gender
  gradeClass   String   @map("grade_class") @db.VarChar(50)
  positionRole String?  @default("Anggota") @map("position_role") @db.VarChar(100)
  createdAt    DateTime @default(now()) @map("created_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@map("team_members")
}

model Payment {
  id                String        @id @default(uuid()) @db.VarChar(36)
  registrationId    String        @map("registration_id") @db.VarChar(36)
  paymentAccountId  String?       @map("payment_account_id") @db.VarChar(36)
  amount            Decimal       @db.Decimal(12, 2)
  proofImagePath    String        @map("proof_image_path") @db.VarChar(255)
  senderBank        String?       @map("sender_bank") @db.VarChar(100)
  senderAccountName String?       @map("sender_account_name") @db.VarChar(150)
  paymentDate       DateTime      @map("payment_date") @db.Date
  status            PaymentStatus @default(WAITING_VERIFICATION)
  notes             String?       @db.Text
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  registration     Registration             @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  paymentAccount   PaymentAccount?          @relation(fields: [paymentAccountId], references: [id], onDelete: SetNull)
  verificationLogs PaymentVerificationLog[]

  @@index([registrationId])
  @@map("payments")
}

model PaymentVerificationLog {
  id               String             @id @default(uuid()) @db.VarChar(36)
  paymentId        String             @map("payment_id") @db.VarChar(36)
  verifiedByUserId String             @map("verified_by_user_id") @db.VarChar(36)
  action           VerificationAction
  rejectionReason  String?            @map("rejection_reason") @db.Text
  verifiedAt       DateTime           @default(now()) @map("verified_at")

  payment    Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  verifiedBy User    @relation(fields: [verifiedByUserId], references: [id], onDelete: Restrict)

  @@map("payment_verification_logs")
}

model CheckIn {
  id                String         @id @default(uuid()) @db.VarChar(36)
  registrationId    String         @unique @map("registration_id") @db.VarChar(36)
  checkedInByUserId String         @map("checked_in_by_user_id") @db.VarChar(36)
  checkInMethod     CheckInMethod  @map("check_in_method")
  checkInTime       DateTime       @default(now()) @map("check_in_time")
  notes             String?        @db.Text

  // Stage 2: masuk arena lomba (opsional)
  checkIn2Time       DateTime?     @map("check_in_2_time")
  checkIn2ByUserId   String?       @map("check_in_2_by_user_id") @db.VarChar(36)
  checkIn2Method     CheckInMethod? @map("check_in_2_method")
  notes2             String?        @db.Text @map("notes_2")

  registration  Registration @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  checkedInBy   User         @relation("CheckInStaff1", fields: [checkedInByUserId], references: [id], onDelete: Restrict)
  checkedInBy2  User?        @relation("CheckInStaff2", fields: [checkIn2ByUserId], references: [id], onDelete: Restrict)

  @@map("check_ins")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.VarChar(36)
  userId      String?  @map("user_id") @db.VarChar(36)
  action      String   @db.VarChar(100)
  targetTable String   @map("target_table") @db.VarChar(50)
  targetId    String?  @map("target_id") @db.VarChar(36)
  details     String?  @db.Text
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  userAgent   String?  @map("user_agent") @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model AppSetting {
  key       String   @id @db.VarChar(100)
  value     String?  @db.Text
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("app_settings")
}
