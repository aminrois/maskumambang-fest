# ==========================================
# NODE.JS / NESTJS ENVIRONMENT CONFIGURATION
# Salin file ini menjadi .env dan sesuaikan nilainya
# cp .env.example .env
# ==========================================

NODE_ENV=production
PORT=3000
API_PREFIX=/api

# ---- Database Connection (PostgreSQL) ----
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME?schema=public
DATABASE_URL="postgresql://lomba_user:GANTI_PASSWORD_DB@localhost:5432/lomba_db?schema=public"

# ---- Authentication & Security ----
# Generate dengan: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=GANTI_DENGAN_RANDOM_STRING_MIN_64_KARAKTER
JWT_EXPIRATION=7d

# ---- QR Code HMAC Signature Salt ----
# Generate dengan: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
QR_SECRET_SALT=GANTI_DENGAN_RANDOM_STRING_MIN_64_KARAKTER

# ---- Super Admin Reset Code ----
# Kode rahasia untuk mereset data operasional (hanya superadmin)
DATA_RESET_CODE=GANTI_KODE_RESET_ANDA

# ---- File Upload ----
UPLOAD_FOLDER=uploads
MAX_FILE_SIZE_BYTES=5242880

# ---- Rate Limiting ----
THROTTLE_TTL=60000
THROTTLE_LIMIT=60

# ---- Google reCAPTCHA v2 ----
RECAPTCHA_ENABLED=true
RECAPTCHA_SITE_KEY=6LcNx7AtAAAAAB3M-N6Qp_7H2FBu5Qrn4GN6erAV
RECAPTCHA_SECRET_KEY=6LcNx7AtAAAAALe3Rn0nQn_o_Hxd4YQHmMwCINA-

