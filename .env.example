# ==========================================
# NODE.JS / NESTJS ENVIRONMENT CONFIGURATION
# ==========================================

NODE_ENV=production
PORT=3000
API_PREFIX=/api

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://lomba_user:CHANGE_ME_SECURE_PASSWORD@localhost:5432/lomba_db?schema=public&sslmode=prefer"

# Authentication & Security Secrets (Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your_jwt_secret_at_least_64_characters_long_for_production_security
JWT_EXPIRATION=7d

# QR Code HMAC Signature Salt
QR_SECRET_SALT=your_qr_secret_salt_at_least_64_characters_long_for_security

# Super Admin Operational Data Reset Code
DATA_RESET_CODE=RESET124

# File Upload Storage
UPLOAD_FOLDER=uploads
MAX_FILE_SIZE_BYTES=5242880

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=60
